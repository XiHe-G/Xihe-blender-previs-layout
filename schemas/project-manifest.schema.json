{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blender-previs-layout/project-manifest.schema.json",
  "title": "Blender Previs Layout V1 Project Manifest",
  "type": "object",
  "required": ["project_id", "scene", "characters", "shots"],
  "properties": {
    "version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "layout_mode": {"enum": ["NARRATIVE", "COMBAT_DYNAMIC"]},
    "proxy_style": {"enum": ["AUTO", "NARRATIVE_BOX_5", "COMBAT_BOX_4", "ARTICULATED"]},
    "fps": {"type": "integer", "minimum": 1},
    "resolution": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 16}, {"type": "integer", "minimum": 16}],
      "minItems": 2,
      "maxItems": 2
    },
    "scene": {
      "type": "object",
      "required": ["id", "elements"],
      "properties": {
        "id": {"type": "string"},
        "elements": {"type": "array", "items": {"type": "object", "required": ["id", "type"]}}
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "position"],
        "properties": {
          "id": {"type": "string"},
          "proxy_style": {"enum": ["AUTO", "NARRATIVE_BOX_5", "COMBAT_BOX_4", "ARTICULATED"]},
          "width_ratio": {"type": "number", "exclusiveMinimum": 0},
          "depth_ratio": {"type": "number", "exclusiveMinimum": 0},
          "head_radius_ratio": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 0.49},
          "lower_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
          "proxy_type": {"enum": ["HUMAN", "HUMANOID", "BIPED_CREATURE", "QUADRUPED", "GENERIC_CREATURE", "CORPSE"]},
          "position": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "actions", "camera"],
        "properties": {
          "id": {"type": "string"},
          "frames": {"type": "integer", "minimum": 1},
          "duration": {"type": "number", "exclusiveMinimum": 0},
          "actions": {"type": "array", "items": {"type": "object", "required": ["character", "primitive"]}},
          "camera": {"type": "object"}
        }
      }
    }
  }
}
