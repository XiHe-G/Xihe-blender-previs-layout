{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "REPAIR-ASSESSMENT/1.1"
    },
    "TARGET_RESULT": {
      "enum": [
        "FIXED",
        "PARTIALLY_FIXED",
        "NOT_FIXED",
        "REGRESSION_INTRODUCED",
        "ABORTED"
      ]
    },
    "SIDE_EFFECT_RESULT": {
      "enum": [
        "PASS",
        "WARNING",
        "FAIL",
        "NOT_REVIEWED"
      ]
    },
    "MOTION_QUALITY_RESULT": {
      "enum": [
        "PASS",
        "WARNING",
        "FAIL",
        "NOT_REVIEWED"
      ]
    },
    "overall": {
      "enum": [
        "FIXED",
        "FIXED_WITH_WARNING",
        "PARTIALLY_FIXED",
        "NOT_FIXED",
        "REGRESSION_INTRODUCED",
        "ABORTED"
      ]
    },
    "historical_result_sha256": {
      "type": "string"
    },
    "historical_result_unchanged": {
      "const": true
    },
    "automatic_repair": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "TARGET_RESULT",
    "SIDE_EFFECT_RESULT",
    "MOTION_QUALITY_RESULT",
    "overall",
    "historical_result_sha256",
    "historical_result_unchanged",
    "automatic_repair"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
