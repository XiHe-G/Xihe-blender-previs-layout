{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRIMITIVE-EXECUTION-FRAGMENT/1.0 (single or composite envelope)",
  "$defs": {
    "fragment": {
      "type": "object",
      "required": [
        "fragment_version",
        "primitive_id",
        "primitive_sha256",
        "affected_entity",
        "time_range",
        "world_samples",
        "pose_samples",
        "ownership_samples",
        "metadata",
        "entry_state_actual",
        "exit_state_actual",
        "continuity_report",
        "channel_ownership",
        "timebase",
        "execution_sha256"
      ],
      "properties": {
        "fragment_version": {
          "const": "PRIMITIVE-EXECUTION-FRAGMENT/1.0"
        },
        "primitive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "time_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "world_samples": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "frame",
              "time",
              "position",
              "orientation",
              "velocity"
            ],
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 1
              },
              "time": {
                "type": "number",
                "minimum": 0
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "orientation": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "velocity": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        "entry_state_actual": {
          "type": "object",
          "required": [
            "position",
            "velocity",
            "movement_direction",
            "orientation",
            "angular_velocity",
            "ownership_state"
          ],
          "properties": {
            "position": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "velocity": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "movement_direction": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "orientation": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "angular_velocity": {
              "type": "number"
            },
            "ownership_state": {
              "type": "string"
            },
            "support_state": {
              "type": "string"
            },
            "lens": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "camera_velocity": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "subject_screen_position": {
              "type": [
                "array",
                "null"
              ]
            },
            "subject_screen_size": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "exit_state_actual": {
          "type": "object",
          "required": [
            "position",
            "velocity",
            "movement_direction",
            "orientation",
            "angular_velocity",
            "ownership_state"
          ],
          "properties": {
            "position": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "velocity": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "movement_direction": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "orientation": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "angular_velocity": {
              "type": "number"
            },
            "ownership_state": {
              "type": "string"
            },
            "support_state": {
              "type": "string"
            },
            "lens": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "camera_velocity": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "subject_screen_position": {
              "type": [
                "array",
                "null"
              ]
            },
            "subject_screen_size": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "execution_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/fragment"
    },
    {
      "type": "object",
      "required": [
        "fragment_version",
        "program_sha256",
        "fragments",
        "composition"
      ],
      "additionalProperties": false,
      "properties": {
        "fragment_version": {
          "const": "PRIMITIVE-EXECUTION-FRAGMENT/1.0"
        },
        "program_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fragments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fragment"
          }
        },
        "composition": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "members"
            ],
            "properties": {
              "type": {
                "enum": [
                  "SEQUENTIAL",
                  "ORTHOGONAL_CHANNEL",
                  "EXPLICIT_ADDITIVE_OFFSET"
                ]
              },
              "members": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  ]
}