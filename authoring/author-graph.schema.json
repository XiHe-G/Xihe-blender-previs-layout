    "origin": {
      "enum": [
        "AUTHORED",
        "MIGRATION",
        "DEBUG"
      ]
    },
    "module": {
      "enum": [
        "NARRATIVE",
        "COMBAT_DYNAMIC"
      ]
    },
    "entry_mode": {
      "enum": [
        "SOURCE",
        "TEXT"
      ]
    },
    "timebase": {
      "type": "object",
      "properties": {
        "time_unit": {
          "const": "seconds"
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frame_origin": {
          "const": 1
        }
      },
      "required": [
        "time_unit",
        "fps",
        "duration",
        "frame_origin"
      ],
      "additionalProperties": false
    },
